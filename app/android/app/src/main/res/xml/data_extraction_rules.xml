<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in tokens and settings stay on this phone: never copied to cloud backup or a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
