#: apps/billing/refunds.py
#, python-brace-format
msgid "You can refund at most {amount}."
msgstr "آپ زیادہ سے زیادہ {amount} واپس کر سکتے ہیں۔"

#: apps/billing/refunds.py
msgid "Refund charged to your wallet"
msgstr "ریفنڈ آپ کے والٹ سے کاٹا گیا"

#: apps/billing/refunds.py
#, python-brace-format
msgid "The customer of booking #{id} was refunded {amount}. Your share, {share}, is taken from your wallet."
msgstr "بکنگ #{id} کے گاہک کو {amount} واپس کیے گئے۔ آپ کا حصہ، {share}، آپ کے والٹ سے کاٹا گیا ہے۔"

