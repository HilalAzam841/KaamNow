#: apps/accounts/phone.py
msgid "Confirm your phone number first. We will send you a code by SMS."
msgstr "پہلے اپنا فون نمبر کنفرم کریں۔ ہم آپ کو SMS سے کوڈ بھیجیں گے۔"

#: apps/accounts/phone.py
msgid "Please wait %(seconds)s seconds before asking for a new code."
msgstr "نیا کوڈ مانگنے سے پہلے %(seconds)s سیکنڈ انتظار کریں۔"

#: apps/accounts/phone.py
msgid "Too many codes requested for this number today. Please try again tomorrow."
msgstr "آج اس نمبر کے لیے بہت زیادہ کوڈ مانگے جا چکے ہیں۔ کل دوبارہ کوشش کریں۔"

#: apps/accounts/phone.py
msgid "Your KaamNow code is %(code)s. It expires in %(minutes)s minutes. Never share it with anyone."
msgstr "آپ کا کام ناؤ کوڈ %(code)s ہے۔ یہ %(minutes)s منٹ میں ختم ہو جائے گا۔ یہ کوڈ کسی کو نہ بتائیں۔"

#: apps/accounts/phone.py
msgid "We could not send the SMS. Please try again in a few minutes."
msgstr "SMS نہیں بھیجا جا سکا۔ چند منٹ بعد دوبارہ کوشش کریں۔"

#: apps/accounts/serializers.py
msgid "This email is already in use."
msgstr "یہ ای میل پہلے سے استعمال میں ہے۔"

#: apps/accounts/serializers.py
msgid "This invite code does not exist."
msgstr "یہ دعوتی کوڈ موجود نہیں ہے۔"

#: apps/accounts/serializers.py
msgid "An account with this phone number already exists."
msgstr "اس فون نمبر سے اکاؤنٹ پہلے سے موجود ہے۔"

#: apps/accounts/serializers.py
msgid "An account with this email already exists."
msgstr "اس ای میل سے اکاؤنٹ پہلے سے موجود ہے۔"

#: apps/accounts/serializers.py
msgid "Enter your full name."
msgstr "اپنا پورا نام درج کریں۔"

#: apps/accounts/serializers.py
msgid "CNIC number is required for service providers."
msgstr "کاریگروں کے لیے شناختی کارڈ نمبر ضروری ہے۔"

#: apps/accounts/serializers.py
msgid "This CNIC is already registered."
msgstr "یہ شناختی کارڈ پہلے سے رجسٹرڈ ہے۔"

#: apps/accounts/serializers.py
msgid "Invalid phone number or password."
msgstr "فون نمبر یا پاس ورڈ غلط ہے۔"

#: apps/accounts/serializers.py
msgid "This account is suspended. Contact support."
msgstr "یہ اکاؤنٹ معطل ہے۔ سپورٹ سے رابطہ کریں۔"

#: apps/accounts/serializers.py
msgid "Provide your phone number or email."
msgstr "اپنا فون نمبر یا ای میل درج کریں۔"

#: apps/accounts/serializers.py
msgid "CNIC cannot be changed after verification. Contact support."
msgstr "تصدیق کے بعد شناختی کارڈ تبدیل نہیں ہو سکتا۔ سپورٹ سے رابطہ کریں۔"

#: apps/accounts/serializers.py
msgid "Provide both base_latitude and base_longitude."
msgstr "لوکیشن کے دونوں حصے (base_latitude اور base_longitude) درج کریں۔"

#: apps/accounts/services.py
msgid "Only customer and worker accounts can self-register."
msgstr "صرف گاہک اور کاریگر خود رجسٹر ہو سکتے ہیں۔"

#: apps/accounts/services.py
msgid "This worker is already verified."
msgstr "اس کاریگر کی تصدیق پہلے ہو چکی ہے۔"

#: apps/accounts/services.py
msgid "Worker has not uploaded CNIC documents yet."
msgstr "کاریگر نے ابھی شناختی کارڈ اپ لوڈ نہیں کیا۔"

#: apps/accounts/services.py
msgid "Account verified"
msgstr "اکاؤنٹ کی تصدیق ہو گئی"

#: apps/accounts/services.py
msgid "Your KaamNow service provider account is verified. You can now go online and receive jobs."
msgstr "آپ کے کام ناؤ کاریگر اکاؤنٹ کی تصدیق ہو گئی ہے۔ اب آپ آن لائن ہو کر کام حاصل کر سکتے ہیں۔"

#: apps/accounts/services.py
msgid "Verification unsuccessful"
msgstr "تصدیق نہیں ہو سکی"

#: apps/accounts/services.py
#, python-brace-format
msgid "Your verification was not approved: {reason}"
msgstr "آپ کی تصدیق منظور نہیں ہوئی: {reason}"

#: apps/accounts/services.py
msgid "Your account must be verified before you can go online."
msgstr "آن لائن ہونے سے پہلے آپ کے اکاؤنٹ کی تصدیق ضروری ہے۔"

#: apps/accounts/services.py
msgid "Set your service location before going online."
msgstr "آن لائن ہونے سے پہلے اپنی سروس لوکیشن مقرر کریں۔"

#: apps/accounts/services.py
msgid "Add at least one service category before going online."
msgstr "آن لائن ہونے سے پہلے کم از کم ایک سروس شامل کریں۔"

#: apps/accounts/services.py
msgid "You cannot suspend your own account."
msgstr "آپ اپنا اکاؤنٹ معطل نہیں کر سکتے۔"

#: apps/accounts/views.py
msgid "If an account matches, password reset instructions have been sent."
msgstr "اگر اکاؤنٹ موجود ہے تو پاس ورڈ ری سیٹ کرنے کی ہدایات بھیج دی گئی ہیں۔"

#: apps/accounts/views.py
msgid "Wrong or expired code."
msgstr "کوڈ غلط ہے یا اس کی مدت ختم ہو چکی ہے۔"

#: apps/accounts/views.py
msgid "Password has been reset. Please log in."
msgstr "پاس ورڈ ری سیٹ ہو گیا۔ براہ کرم لاگ ان کریں۔"

#: apps/accounts/views.py
msgid "Your phone number is already confirmed."
msgstr "آپ کا فون نمبر پہلے ہی کنفرم ہے۔"

#: apps/accounts/views.py
msgid "SMS is not set up on this server."
msgstr "اس سرور پر SMS ابھی سیٹ اپ نہیں ہوا۔"

#: apps/accounts/views.py
msgid "Code sent."
msgstr "کوڈ بھیج دیا گیا۔"

#: apps/accounts/views.py
msgid "Current password is incorrect."
msgstr "موجودہ پاس ورڈ غلط ہے۔"

#: apps/addresses/serializers.py
msgid "Write the full address (house, street, block)."
msgstr "پورا پتہ لکھیں (مکان، گلی، بلاک)۔"

#: apps/addresses/serializers.py
msgid "Give this place a name, e.g. Ammi's house."
msgstr "اس جگہ کا نام رکھیں، جیسے امی کا گھر۔"

#: apps/addresses/services.py
msgid "You already saved a Home address. Edit that one instead."
msgstr "آپ گھر کا پتہ پہلے ہی محفوظ کر چکے ہیں۔ اسی میں تبدیلی کریں۔"

#: apps/addresses/services.py
msgid "You already saved a Work address. Edit that one instead."
msgstr "آپ دفتر کا پتہ پہلے ہی محفوظ کر چکے ہیں۔ اسی میں تبدیلی کریں۔"

#: apps/addresses/services.py
msgid "You can save up to 10 addresses. Delete one first."
msgstr "آپ زیادہ سے زیادہ 10 پتے محفوظ کر سکتے ہیں۔ پہلے کوئی ایک حذف کریں۔"

