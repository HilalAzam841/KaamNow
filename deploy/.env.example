# KaamNow production settings. Copy to deploy/.env (or run ./new-env.sh) and fill in.
# Never commit deploy/.env.

# --- Site --------------------------------------------------------------------
# The domain whose DNS A record points at this server. Caddy gets the HTTPS certificate for it.
DOMAIN=kaamnow.pk
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com
# Leave empty to serve https://$DOMAIN. Set to e.g. "kaamnow.pk, www.kaamnow.pk" for several names.
SITE_ADDRESS=

# --- Images ------------------------------------------------------------------
# "kaamnow" = images built on this server with `docker compose build`.
# "ghcr.io/<github-user>/kaamnow" = images built by GitHub Actions (lowercase user name).
IMAGE_PREFIX=kaamnow
# Image tag. GitHub Actions deploys set this to the commit SHA; change it back to roll back.
TAG=latest

# --- Secrets (./new-env.sh generates these) -----------------------------------
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kaamnow
POSTGRES_USER=kaamnow

# --- App ---------------------------------------------------------------------
SUPPORT_EMAIL=support@kaamnow.pk
SUPPORT_PHONE=
LOG_LEVEL=INFO
BACKUP_KEEP_DAYS=14

# --- Email (password-reset links) --------------------------------------------
# Without SMTP, reset emails are only written to the API log.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=KaamNow <no-reply@kaamnow.pk>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Payments (later; leave blank to keep a method off) ------------------------
# Callback URLs default to https://$DOMAIN/api/v1/payments/callbacks/<gateway>/.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_ACCOUNT_NUM=

# --- Browser notifications (web push; ./new-env.sh generates these) ----------------
# Or: docker compose run --rm api python manage.py generate_vapid_keys
# Keep them for the life of the site: new keys sign every browser out of notifications.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# --- SMS codes (confirming phone numbers, "Forgot password") -------------------
# console = codes only appear in the server log. twilio = real SMS (see deploy/README.md).
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number (+1...) or an approved sender ID such as KaamNow
TWILIO_FROM=
# Customers and workers confirm their number before posting jobs or sending offers.
# Defaults to on when SMS_BACKEND is a real service, off with console.
# PHONE_VERIFICATION_REQUIRED=true

# --- Push notifications for the mobile apps (later) -------------------------------
# Put the key at deploy/secrets/firebase.json and uncomment its line in docker-compose.yml.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# Google Maps on the website: a key restricted to your domain (app/README.md, "Google Maps").
# Empty = OpenStreetMap.
GOOGLE_MAPS_BROWSER_KEY=
