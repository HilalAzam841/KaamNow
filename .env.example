# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional separate key for signing JWTs (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
CORS_ALLOWED_ORIGINS=
SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=kaamnow
POSTGRES_USER=kaamnow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# --- Files --------------------------------------------------------------------
MEDIA_ROOT=/var/lib/kaamnow/media
# CNIC documents. Must NOT be served by the web server.
PRIVATE_MEDIA_ROOT=/var/lib/kaamnow/private_media
MAX_IMAGE_UPLOAD_MB=5
MAX_DOCUMENT_UPLOAD_MB=5
MAX_REQUEST_IMAGES=5

# --- Email (password reset) ---------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=KaamNow <no-reply@kaamnow.pk>
PASSWORD_RESET_URL=https://app.kaamnow.pk/reset-password?uid={uid}&token={token}
# EMAIL_HOST=  EMAIL_PORT=587  EMAIL_HOST_USER=  EMAIL_HOST_PASSWORD=  EMAIL_USE_TLS=true

# --- Business rules -----------------------------------------------------------
DEFAULT_COMMISSION_PERCENT=10.00
MAX_DISCOVERY_RADIUS_KM=50
MIN_OFFER_PRICE=100
MAX_OFFER_PRICE=1000000
MAX_NEGOTIATION_ROUNDS=10
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
GEO_BACKEND=haversine

# --- Throttling ---------------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_OTP=10/min
THROTTLE_OFFERS=60/min
