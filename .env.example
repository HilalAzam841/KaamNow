# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional separate key for signing JWTs (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Browser origins allowed to call the API and open WebSockets, e.g. https://app.kaamnow.pk
# (in DEBUG, any http://localhost:<port> is allowed for the Flutter dev server).
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_REGEXES=
# Served by GET /api/v1/app/config/
MIN_ANDROID_VERSION=1.0.0
MIN_IOS_VERSION=1.0.0
MIN_WEB_VERSION=1.0.0
SUPPORT_EMAIL=support@kaamnow.pk
SUPPORT_PHONE=
SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=kaamnow
POSTGRES_USER=kaamnow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# --- Redis / Channels / Celery ------------------------------------------------
# Required in production: shared cache + throttling, WebSocket fan-out across processes, Celery broker.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL defaults to REDIS_URL. Without Redis, tasks run inline (dev only).
CELERY_TASK_ALWAYS_EAGER=false

# --- Firebase Cloud Messaging (push notifications) -----------------------------
# Browser notifications (web push): python manage.py generate_vapid_keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# --- SMS codes (confirming phone numbers, "Forgot password") -------------------
# console = codes only appear in the server log. twilio = real SMS (see deploy/README.md).
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number (+1...) or an approved sender ID such as KaamNow
TWILIO_FROM=
# Customers and workers confirm their number before posting jobs or sending offers.
# Defaults to on when SMS_BACKEND is a real service, off with console.
# PHONE_VERIFICATION_REQUIRED=true

FCM_PROJECT_ID=
# Absolute path to the Firebase service-account JSON. Never commit this file.
FCM_CREDENTIALS_FILE=

# --- Payment gateways (leave blank to disable a method) ------------------------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_CHECKOUT_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
JAZZCASH_RETURN_URL=https://api.kaamnow.pk/api/v1/payments/callbacks/jazzcash/
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_CHECKOUT_URL=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf
EASYPAISA_INQUIRY_URL=https://easypaystg.easypaisa.com.pk/easypay-service/rest/v4/inquire-transaction
EASYPAISA_POSTBACK_URL=https://api.kaamnow.pk/api/v1/payments/callbacks/easypaisa/
ONLINE_PAYMENT_TTL_MINUTES=30

# --- Files --------------------------------------------------------------------
MEDIA_ROOT=/var/lib/kaamnow/media
# CNIC documents. Must NOT be served by the web server.
PRIVATE_MEDIA_ROOT=/var/lib/kaamnow/private_media
MAX_IMAGE_UPLOAD_MB=5
MAX_DOCUMENT_UPLOAD_MB=5
MAX_REQUEST_IMAGES=5

# --- Email (password reset) ---------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=KaamNow <no-reply@kaamnow.pk>
PASSWORD_RESET_URL=https://app.kaamnow.pk/reset-password?uid={uid}&token={token}
INVITE_URL=https://app.kaamnow.pk/register?ref={code}
TRIP_SHARE_URL=https://app.kaamnow.pk/share/{token}
# EMAIL_HOST=  EMAIL_PORT=587  EMAIL_HOST_USER=  EMAIL_HOST_PASSWORD=  EMAIL_USE_TLS=true

# --- Business rules -----------------------------------------------------------
DEFAULT_COMMISSION_PERCENT=10.00
MAX_DISCOVERY_RADIUS_KM=50
MIN_OFFER_PRICE=100
MAX_OFFER_PRICE=1000000
MAX_NEGOTIATION_ROUNDS=10
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
GEO_BACKEND=haversine
REQUEST_EXPIRY_HOURS=24
MAX_FEATURED_PER_CATEGORY=5
LOCATION_RETENTION_DAYS=30
AVERAGE_CITY_SPEED_KMH=25
CHAT_OPEN_HOURS_AFTER_COMPLETION=48

# --- Throttling ---------------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_OTP=10/min
THROTTLE_OFFERS=60/min
THROTTLE_CHAT=60/min
THROTTLE_LOCATION=120/min
THROTTLE_PAYMENT_CALLBACK=120/min
THROTTLE_PAYOUT=20/hour
THROTTLE_STATEMENT=30/hour
THROTTLE_RECEIPT=60/hour

# Google Maps on the website (see app/README.md, "Google Maps"). Leave empty for OpenStreetMap.
GOOGLE_MAPS_BROWSER_KEY=

# Receipts
RECEIPT_COMPANY=KaamNow
RECEIPT_ADDRESS=Lahore, Pakistan
RECEIPT_TAX_NUMBER=
